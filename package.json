{
  "name": "the-guild",
  "private": true,
  "version": "0.1.0",
  "description": "A post-apocalyptic scavenger-guild management game for Android.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/ui",
    "check": "npm run typecheck && npm test && npm run build",
    "sample": "node scripts/sample.ts",
    "run-sample": "node scripts/run.ts",
    "balance": "node scripts/balance.ts",
    "career": "node scripts/career.ts",
    "portraits": "node scripts/portraits.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.7"
  },
  "dependencies": {
    "@fontsource-variable/big-shoulders-stencil": "^5.3.0",
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
